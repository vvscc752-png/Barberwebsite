<!DOCTYPE html>
<html lang="sk">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Prestige Barbershop — Rovinka</title>
<meta name="description" content="Prestige Barbershop, Rovinka. Rezervuj si termín online." />

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  :root{
    --black: #0A0908;
    --gold:  #E5B53A;
    --white: #FFFFFF;
    --gray:  #9B958A;
    --line:  #2A241A;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    background:var(--black);
    color:var(--white);
    font-family:'Manrope',sans-serif;
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
  }

  .wrap{
    max-width:560px;
    margin:0 auto;
    padding:3rem 1.5rem 2rem;
    display:flex;flex-direction:column;
  }

  /* HERO */
  .hero{text-align:center;padding:1.5rem 0 2.5rem}
  .badge{
    width:88px;height:88px;border-radius:50%;
    border:2px solid var(--gold);
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 1.5rem;
    font-family:'Bebas Neue',sans-serif;
    font-size:2.2rem;color:var(--gold);
    letter-spacing:.04em;
  }
  h1{
    font-family:'Bebas Neue',sans-serif;
    font-size:clamp(2.8rem,11vw,4rem);
    line-height:.95;
    letter-spacing:.04em;
    margin-bottom:.5rem;
  }
  h1 .gold{color:var(--gold)}
  .tag{
    color:var(--gray);
    font-size:.78rem;
    letter-spacing:.3em;
    text-transform:uppercase;
    margin-bottom:1.8rem;
  }
  .cta{
    display:inline-block;
    background:var(--gold);
    color:var(--black);
    font-family:'Bebas Neue',sans-serif;
    font-size:1.15rem;
    letter-spacing:.2em;
    padding:1.1rem 2.2rem;
    text-decoration:none;
    border:2px solid var(--gold);
    transition:all .25s ease;
    cursor:pointer;
  }
  .cta:hover{background:transparent;color:var(--gold)}

  /* BLOCKS */
  .block{
    padding:2rem 0;
    border-top:1px solid var(--line);
  }
  .block h2{
    font-family:'Bebas Neue',sans-serif;
    font-size:1rem;
    letter-spacing:.3em;
    color:var(--gold);
    margin-bottom:1.2rem;
  }

  .row{
    display:flex;justify-content:space-between;align-items:baseline;
    padding:.7rem 0;
    gap:1rem;
  }
  .row + .row{border-top:1px solid var(--line)}
  .row .name{
    font-family:'Manrope',sans-serif;
    font-weight:500;
    font-size:1rem;
  }
  .row .val{
    font-family:'Bebas Neue',sans-serif;
    font-size:1.2rem;
    color:var(--gold);
    letter-spacing:.04em;
    white-space:nowrap;
  }
  .row.muted .val{color:var(--gray);font-family:'Manrope',sans-serif;font-size:.92rem;font-weight:500}

  /* RESERVATION (embedded Bookio) */
  .reserve-wrap{
    background:var(--white);
    border:1px solid var(--line);
    overflow:hidden;
    margin-top:.5rem;
  }
  .reserve-wrap iframe{
    width:100%;
    height:760px;
    border:0;
    display:block;
  }
  .fallback{
    padding:1rem 0 0;
    text-align:center;
    font-size:.85rem;
    color:var(--gray);
  }
  .fallback a{color:var(--gold)}

  /* FOOTER */
  footer{
    padding:2.5rem 0 0;
    text-align:center;
    color:var(--gray);
    font-size:.8rem;
    letter-spacing:.18em;
    text-transform:uppercase;
  }
  footer .links{
    display:flex;justify-content:center;gap:1.5rem;
    margin-bottom:1.5rem;
  }
  footer a{
    color:var(--white);
    text-decoration:none;
    transition:color .2s;
  }
  footer a:hover{color:var(--gold)}

  @media (max-width:560px){
    .wrap{padding:2rem 1.1rem 1.5rem}
    .reserve-wrap iframe{height:680px}
  }
</style>
</head>
<body>

<div class="wrap">

  <!-- HERO -->
  <header class="hero">
    <div class="badge">P</div>
    <h1>Prestige<br/><span class="gold">Barbershop</span></h1>
    <div class="tag">📍 Rovinka</div>
    <a class="cta" href="#rezervacia">Rezervovať termín</a>
  </header>

  <!-- SERVICES -->
  <section class="block">
    <h2>Cenník</h2>
    <div class="row"><span class="name">Úprava vlasov</span><span class="val">od 18 €</span></div>
    <div class="row"><span class="name">Úprava brady</span><span class="val">od 13 €</span></div>
    <div class="row"><span class="name">Prestige Kombo</span><span class="val">od 28 €</span></div>
    <div class="row"><span class="name">Detský strih</span><span class="val">od 14 €</span></div>
    <div class="row"><span class="name">Holenie britvou</span><span class="val">od 15 €</span></div>
  </section>

  <!-- HOURS -->
  <section class="block">
    <h2>Otvorené</h2>
    <div class="row muted"><span class="name">Pondelok – Piatok</span><span class="val">09:00 – 19:00</span></div>
    <div class="row muted"><span class="name">Sobota</span><span class="val">09:00 – 15:00</span></div>
    <div class="row muted"><span class="name">Nedeľa</span><span class="val">Zatvorené</span></div>
  </section>

  <!-- BOOKIO EMBED -->
  <section class="block" id="rezervacia">
    <h2>Rezervácia</h2>
    <div class="reserve-wrap">
      <iframe 
        src="https://services.bookio.com/prestige-barber/widget?lang=sk"
        title="Rezervácia Prestige Barbershop"
        loading="lazy"
        allow="payment">
      </iframe>
    </div>
    <p class="fallback">
      Problém s rezerváciou? <a href="https://services.bookio.com/prestige-barber/widget?lang=sk" target="_blank" rel="noopener">Otvor v novom okne ↗</a>
    </p>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="links">
      <a href="https://www.instagram.com/prestige_barber_shop" target="_blank">Instagram</a>
      <a href="https://services.bookio.com/prestige-barber/widget?lang=sk" target="_blank">Bookio</a>
    </div>
    <div>© Prestige Barbershop</div>
  </footer>

</div>

</body>
</html>
